{
  "name": "msngr",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [
      { "name": "USER_DO", "class_name": "UserDO" },
      { "name": "CONV_DO", "class_name": "ConversationDO" },
      { "name": "APNS_DO", "class_name": "ApnsTokenDO" },
      { "name": "HANDLE_DO", "class_name": "HandleDO" },
      { "name": "DIRECTORY_DO", "class_name": "DirectoryDO" },
      { "name": "STORIES_DO", "class_name": "StoriesDO" },
      { "name": "LOOKUP_DO", "class_name": "LookupDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserSessionDO", "ConversationDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ApnsTokenDO"] },
    { "tag": "v3", "renamed_classes": [{ "from": "UserSessionDO", "to": "UserDO" }] },
    { "tag": "v4", "new_sqlite_classes": ["HandleDO", "DirectoryDO"] },
    { "tag": "v5", "new_sqlite_classes": ["StoriesDO"] },
    { "tag": "v6", "new_sqlite_classes": ["LookupDO"] }
  ],
  // The database holds nothing: every table the server ever kept has followed
  // its owner into a Durable Object. The binding stays so the migration that
  // drops the last of them can be applied where a stand still has them.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "msngr",
      "database_id": "REPLACE_ON_DEPLOY",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "msngr-media" }
  ],
  "vars": {
    "APNS_ENV": "sandbox"
  }
  // secrets: APNS_KEY_P8, APNS_KEY_ID, APNS_TEAM_ID, APNS_TOPIC (wrangler secret put)
}
