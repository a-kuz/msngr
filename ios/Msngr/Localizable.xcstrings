{
  "sourceLanguage": "en",
  "strings": {
    "%lld chats": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld чатов"
          }
        }
      }
    },
    "1 chat": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 чат"
          }
        }
      }
    },
    "A folder collects chats by a rule — people, groups, unread — and keeps whatever you add by hand.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка собирает чаты по правилу — люди, группы, непрочитанные — и хранит всё, что вы добавили вручную."
          }
        }
      }
    },
    "Already have an account — log in by code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже есть аккаунт — войти по коду"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Chats": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты"
          }
        }
      }
    },
    "Chats with contacts": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты с контактами"
          }
        }
      }
    },
    "Contacts: %lld": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакты: %lld"
          }
        }
      }
    },
    "Could not create the account": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать аккаунт"
          }
        }
      }
    },
    "Could not log in on this device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти на этом устройстве"
          }
        }
      }
    },
    "Could not log in: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти: %@"
          }
        }
      }
    },
    "Could not reach the server": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сервером"
          }
        }
      }
    },
    "Could not save the session on this device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить сессию на устройстве"
          }
        }
      }
    },
    "Create account": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать аккаунт"
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Edit": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить"
          }
        }
      }
    },
    "End-to-end encrypted. The keys are created on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сквозное шифрование. Ключи создаются на этом устройстве."
          }
        }
      }
    },
    "Folder": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка"
          }
        }
      }
    },
    "Folder order is tab order. Deleting a folder removes only it — the chats stay put. Folders live on this device.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок папок — это порядок вкладок. Удаление папки убирает только её: чаты остаются на месте. Папки хранятся только на этом устройстве."
          }
        }
      }
    },
    "Folders": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки"
          }
        }
      }
    },
    "Groups": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группы"
          }
        }
      }
    },
    "If this is not your account, cancel the login.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это не ваш аккаунт, отмените вход."
          }
        }
      }
    },
    "Log in": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти"
          }
        }
      }
    },
    "Log in as @%@?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти как @%@?"
          }
        }
      }
    },
    "Log in by code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход по коду"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя"
          }
        }
      }
    },
    "Name — at most %lld characters": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя — не длиннее %lld символов"
          }
        }
      }
    },
    "New Folder": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая папка"
          }
        }
      }
    },
    "No connection to the server": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет связи с сервером"
          }
        }
      }
    },
    "On a device already logged in, open:\nSettings → Devices → Add device\nand enter this code there.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте на устройстве, где уже вошли:\nНастройки → Устройства → Добавить устройство\nи введите этот код."
          }
        }
      }
    },
    "People": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди"
          }
        }
      }
    },
    "Save": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить"
          }
        }
      }
    },
    "Setting up this device…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраиваем устройство…"
          }
        }
      }
    },
    "The account keys did not match. Start over.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи аккаунта не совпали. Начните заново."
          }
        }
      }
    },
    "The code is no longer valid. Start over.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код больше не действует. Начните заново."
          }
        }
      }
    },
    "The code was approved from a different account. Start over.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код подтвердили с чужого аккаунта. Начните заново."
          }
        }
      }
    },
    "The history does not move to this device: older messages stay only where you read them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История переписки на это устройство не переносится: старые сообщения останутся только там, где вы их читали."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробовать снова"
          }
        }
      }
    },
    "Unread": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрочитанные"
          }
        }
      }
    },
    "Username (a-z, 0-9, _)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Юзернейм (a-z, 0-9, _)"
          }
        }
      }
    },
    "Username is taken": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Юзернейм занят"
          }
        }
      }
    },
    "Username — %1$lld to %2$lld characters: latin letters, digits and _": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Юзернейм — от %1$lld до %2$lld символов: латиница, цифры и _"
          }
        }
      }
    },
    "Waiting for confirmation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём подтверждения"
          }
        }
      }
    },
    "Waiting for confirmation · %lld s": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём подтверждения · %lld с"
          }
        }
      }
    },
    "What's included automatically": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что входит автоматически"
          }
        }
      }
    }
  },
  "version": "1.0"
}