    " " : {
      "comment" : "A placeholder text for a chat row.",
      "isCommentAutoGenerated" : true
    },
    "A person's sound plays wherever they write; a chat's own sound still wins inside that chat." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук человека играет везде, где он пишет; собственный звук чата в этом чате всё равно главнее."
          }
        }
      }
    },
    "I'm on Msngr, my username is @%@. Join me!" : {
